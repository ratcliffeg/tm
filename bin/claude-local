#!/usr/bin/env bash
# Claude Code against a local model: the Strata server on another machine, reached over Tailscale.
# Own config dir (~/.claude-local), so it never mixes with the work or personal logins.
# The address, model and token come from tm's settings (~/.config/tm/config):
#   TM_LOCAL_URL    Strata's base URL (Claude Code adds /v1/messages itself)
#   TM_LOCAL_MODEL  model name to send; Strata ignores it and uses whatever it has loaded
#   TM_LOCAL_TOKEN  sent as the bearer token; any value will do if Strata doesn't check it
#   claude-local [claude args...]   run Claude on the local model, right here
#   claude-local --env              print the variables (KEY=value per line, without
#                                   CLAUDE_CONFIG_DIR) for tm and tmux-restore to put on a session
f="${XDG_CONFIG_HOME:-$HOME/.config}/tm/config"
[ -f "$f" ] && . "$f"
url="${TM_LOCAL_URL:-http://7of9-kubuntu.pygmy-parore.ts.net:8080}"
model="${TM_LOCAL_MODEL:-claude-3-5-sonnet-latest}"
# Every model slot gets the same name: Strata runs one model, so background calls share it.
vars=(
    "ANTHROPIC_BASE_URL=${url%/}"
    "ANTHROPIC_AUTH_TOKEN=${TM_LOCAL_TOKEN:-strata}"
    "ANTHROPIC_MODEL=$model"
    "ANTHROPIC_DEFAULT_OPUS_MODEL=$model"
    "ANTHROPIC_DEFAULT_SONNET_MODEL=$model"
    "ANTHROPIC_DEFAULT_HAIKU_MODEL=$model"
    "ANTHROPIC_SMALL_FAST_MODEL=$model"
    "CLAUDE_CODE_SUBAGENT_MODEL=$model"
    # No telemetry, error reporting or update checks to Anthropic from these sessions.
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
)
if [ "${1:-}" = --env ]; then printf '%s\n' "${vars[@]}"; exit 0; fi
export CLAUDE_CONFIG_DIR="$HOME/.claude-local" "${vars[@]}"
exec claude "$@"
