#!/usr/bin/env bash
# Full-screen tmux session picker (fzf): sessions on the left, a view of the highlighted
# session's screen on the right. Also starts new Claude or shell sessions on the work
# account (~/.claude) or personal account (~/.claude-personal).
# Sessions are named W-<FOLDER> (work) / P-<FOLDER> (personal), upper case; Claude starts
# with Remote Control on, named after the session.
# Falls back to the text menu (tm-text) when fzf isn't installed.
set -uo pipefail

# Settings (TM_PROJECTS_ROOT) can go in ~/.config/tm/config; install.sh writes it.
TM_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/tm/config"
[ -f "$TM_CONFIG" ] && . "$TM_CONFIG"
PROJECTS_ROOT="${TM_PROJECTS_ROOT:-$HOME/Code}"
CLAUDE="$(command -v claude || echo "$HOME/.local/bin/claude")"
PERSONAL_DIR="$HOME/.claude-personal"
# fzf calls this script back for previews; no readlink -f on older macOS.
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

command -v fzf >/dev/null || exec "$(dirname "$SELF")/tm-text" "$@"

# Same colours as the tmux status bars (tmux-account-style): blue = personal, green = work.
C_PERSONAL=$'\e[38;2;137;180;250m' C_WORK=$'\e[38;2;166;227;161m' C_DIM=$'\e[2m' C_OFF=$'\e[0m'

# account_of <session> -> personal|work
account_of() {
    if tmux show-environment -t "$1" CLAUDE_CONFIG_DIR 2>/dev/null | grep -q '^CLAUDE_CONFIG_DIR=.*claude-personal'; then
        echo personal
    else
        echo work
    fi
}

go_to() {
    if [ -n "${TMUX:-}" ]; then
        exec tmux switch-client -t "=$1"
    else
        exec tmux attach-session -t "=$1"
    fi
}

# start_session <name> <dir> <command|""> [env]
start_session() {
    local name="$1" dir="$2" cmd="$3" env="${4:-}"
    if ! tmux has-session -t "=$name" 2>/dev/null; then
        local args=(new-session -d -s "$name" -c "$dir")
        [ -n "$env" ] && args+=(-e "$env")
        [ -n "$cmd" ] && args+=("$cmd; exec bash")
        tmux "${args[@]}"
    fi
    go_to "$name"
}

# session_name <prefix> <dir>: "<prefix>-<FOLDER>" in upper case, made unique with -2, -3...
session_name() {
    local base name n=1
    base="$1-$(basename "$2" | tr '.: ' '---' | tr '[:lower:]' '[:upper:]')"
    name=$base
    while tmux has-session -t "=$name" 2>/dev/null; do n=$((n + 1)); name="$base-$n"; done
    echo "$name"
}

# --- preview pane (fzf calls back into this script) ---------------------------------
# Every list line is "<key><TAB><display>"; the key says what the line is:
#   S:<session>  running session      A:<w|p|ws|ps>  new-session action
#   D:<dir>      folder               T:             type a path      X:  separator
preview() {
    local key=$1 dir
    case "$key" in
        S:*) tmux capture-pane -ep -t "=${key#S:}:" 2>/dev/null || echo "(this session has closed)" ;;
        A:w)  printf '%sNew Claude session — WORK account%s\n\nPick a folder next. The session is named W-<FOLDER>\nand Claude starts with Remote Control on.\n' "$C_WORK" "$C_OFF" ;;
        A:p)  printf '%sNew Claude session — PERSONAL account%s\n\nPick a folder next. The session is named P-<FOLDER>\nand Claude starts with Remote Control on.\n' "$C_PERSONAL" "$C_OFF" ;;
        A:ws) printf '%sNew shell session — WORK account%s\n\nA plain terminal, no Claude. Named W-<FOLDER>.\nRunning claude in it uses the work login.\n' "$C_WORK" "$C_OFF" ;;
        A:ps) printf '%sNew shell session — PERSONAL account%s\n\nA plain terminal, no Claude. Named P-<FOLDER>.\nRunning claude in it uses the personal login.\n' "$C_PERSONAL" "$C_OFF" ;;
        D:*)
            dir=${key#D:}
            git -C "$dir" log -1 --format="%C(yellow)%D%C(reset)  %s  %C(dim)%cr%C(reset)" --color=always 2>/dev/null && echo
            # GNU ls (Linux) vs BSD ls (macOS)
            if ls --color=always -d / >/dev/null 2>&1; then
                ls -p --color=always --group-directories-first "$dir" 2>/dev/null | head -200
            else
                CLICOLOR_FORCE=1 ls -pG "$dir" 2>/dev/null | head -200
            fi
            ;;
        T:) echo "Type any folder path, with Tab completion. ~ works." ;;
    esac
}

# Label shown above the preview.
label() {
    local key=$1 s
    case "$key" in
        S:*)
            s=${key#S:}
            printf ' %s · %s · %s ' "$s" "$(tmux display-message -p -t "=$s:" '#{s|^'"$HOME"'|~|:pane_current_path}' 2>/dev/null)" \
                "$(account_of "=$s:" | tr '[:lower:]' '[:upper:]')"
            ;;
        D:*) printf ' %s ' "${key#D:}" | sed "s|$HOME|~|" ;;
        *) printf ' tm ' ;;
    esac
}

case "${1:-}" in
    --preview) preview "$2"; exit 0 ;;
    --label) label "$2"; exit 0 ;;
esac

FZF_OPTS=(
    --ansi --delimiter=$'\t' --with-nth=2 --layout=reverse --border=rounded --info=inline-right
    --preview="$SELF --preview {1}"
    --bind="focus:transform-preview-label:$SELF --label {1}"
    --bind=ctrl-r:refresh-preview
    # Preview on the right; below the list when that would be under 50 columns (phone).
    --preview-window='right,60%,border-left,<50(down,55%,border-top)'
    --color='border:#6c7086,label:#cdd6f4,preview-border:#6c7086,preview-label:#cdd6f4,pointer:#f5c2e7,prompt:#f5c2e7,hl:#f9e2af,hl+:#f9e2af,header:#7f849c'
)

# pick_folder <title>: prints the chosen folder; returns 1 if the user goes back.
pick_folder() {
    local sel path
    while true; do
        sel=$(
            {
                # current folder first so it is the default pick; home only when it differs
                printf 'D:%s\t%s.  current folder (%s)%s\n' "$PWD" "$C_DIM" "${PWD/#$HOME/\~}" "$C_OFF"
                [ "$PWD" != "$HOME" ] && printf 'D:%s\t%s~  home folder%s\n' "$HOME" "$C_DIM" "$C_OFF"
                # (no find -printf on macOS)
                for p in "$PROJECTS_ROOT"/*/; do [ -d "$p" ] && basename "$p"; done | sort -f |
                    while IFS= read -r p; do printf 'D:%s\t%s\n' "$PROJECTS_ROOT/$p" "$p"; done
                printf 'T:\t%s✎  type a path…%s\n' "$C_DIM" "$C_OFF"
            } | fzf "${FZF_OPTS[@]}" --border-label=" $1 · choose a folder " \
                    --header='Enter select · Esc back'
        ) || return 1
        case "${sel%%$'\t'*}" in
            D:*) echo "${sel%%$'\t'*}" | cut -c3-; return 0 ;;
            T:)
                read -erp "Path (Enter = back): " path || return 1
                [ -z "$path" ] && continue
                path="${path/#\~/$HOME}"
                if [ -d "$path" ]; then (cd "$path" && pwd); return 0; fi
                echo "No such folder: $path" >&2; sleep 1.5
                ;;
        esac
    done
}

main_list() {
    local s attached
    while IFS= read -r s; do
        attached=$(tmux display-message -p -t "=$s:" '#{?session_attached, (attached),}')
        if [ "$(account_of "=$s:")" = personal ]; then
            printf 'S:%s\t%s%-22s PERSONAL%s%s%s%s\n' "$s" "$C_PERSONAL" "$s" "$C_OFF" "$C_DIM" "$attached" "$C_OFF"
        else
            printf 'S:%s\t%s%-22s WORK%s%s%s%s\n' "$s" "$C_WORK" "$s" "$C_OFF" "$C_DIM" "$attached" "$C_OFF"
        fi
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
    printf 'X:\t%s──────────────────────────────────%s\n' "$C_DIM" "$C_OFF"
    printf 'A:w\t%s+ Claude   work%s\n' "$C_WORK" "$C_OFF"
    printf 'A:p\t%s+ Claude   personal%s\n' "$C_PERSONAL" "$C_OFF"
    printf 'A:ws\t%s+ Shell    work%s\n' "$C_WORK" "$C_OFF"
    printf 'A:ps\t%s+ Shell    personal%s\n' "$C_PERSONAL" "$C_OFF"
}

while true; do
    sel=$(main_list | fzf "${FZF_OPTS[@]}" --border-label=' tm · tmux sessions ' \
              --header='Enter open · Esc quit · ^R refresh') || exit 0
    key=${sel%%$'\t'*}
    case "$key" in
        S:*) go_to "${key#S:}" ;;
        A:w|A:p)
            dir=$(pick_folder "$([ "$key" = A:w ] && echo 'Claude · work' || echo 'Claude · personal')") || continue
            name=$(basename "$dir" | tr '.: ' '---' | tr '[:lower:]' '[:upper:]')
            if [ "$key" = A:w ]; then
                start_session "W-$name" "$dir" "$CLAUDE --remote-control W-$name"
            else
                start_session "P-$name" "$dir" "$CLAUDE --remote-control P-$name" "CLAUDE_CONFIG_DIR=$PERSONAL_DIR"
            fi
            ;;
        A:ws|A:ps)
            dir=$(pick_folder "$([ "$key" = A:ws ] && echo 'Shell · work' || echo 'Shell · personal')") || continue
            if [ "$key" = A:ws ]; then
                start_session "$(session_name W "$dir")" "$dir" ""
            else
                start_session "$(session_name P "$dir")" "$dir" "" "CLAUDE_CONFIG_DIR=$PERSONAL_DIR"
            fi
            ;;
    esac
done
