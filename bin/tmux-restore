#!/usr/bin/env bash
# Recreate the tmux sessions recorded by tmux-save, resuming each Claude conversation
# with Remote Control on (named after the session, so it shows up on claude.ai/code).
# Runs once at boot/login (tmux-restore.service on Linux, tm.restore launchd agent on macOS); safe to run by hand, it skips sessions that exist.
set -u
snapshot="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-sessions/sessions.tsv"
[ -s "$snapshot" ] || exit 0

while IFS= read -r line; do
  # Tab is IFS whitespace, so `read` would merge empty fields; split on a non-whitespace byte.
  line=${line//$'\t'/$'\x1f'}
  IFS=$'\x1f' read -r name cwd id config_dir <<<"$line"
  [ -n "$name" ] || continue
  tmux has-session -t "=$name" 2>/dev/null && continue
  [ -d "$cwd" ] || cwd="$HOME"
  # Sessions on another account (e.g. ~/.claude-personal) get CLAUDE_CONFIG_DIR back.
  env_args=()
  [ -n "${config_dir:-}" ] && env_args=(-e "CLAUDE_CONFIG_DIR=$config_dir")
  # ${a[@]+...}: bash 3.2 (macOS) errors on an empty array under set -u.
  sid=$(tmux new-session -d -P -F '#{session_id}' -s "$name" -c "$cwd" ${env_args[@]+"${env_args[@]}"})
  if [ -n "$id" ]; then
    tmux send-keys -t "$sid" "claude --resume $id --remote-control '$name'" Enter
  fi
  echo "restored $name ($cwd)${id:+ claude $id}${config_dir:+ [$config_dir]}"
done <"$snapshot"
